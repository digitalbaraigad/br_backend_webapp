# Do not commit this file with real values. Configure these through your host's
# encrypted environment-variable settings.
SPRING_PROFILES_ACTIVE=preprod
SERVER_PORT=8080
DB_URL=jdbc:postgresql://<host>:5432/<database>
DB_USERNAME=<database-user>
DB_PASSWORD=<database-password>
JWT_SECRET=<long-random-secret>
JWT_EXPIRATION=86400000
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_USERNAME=<smtp-user>
MAIL_PASSWORD=<smtp-password>
WHATSAPP_API_URL=https://graph.facebook.com/v23.0/<phone-number-id>/messages
WHATSAPP_ACCESS_TOKEN=<whatsapp-access-token>
BARAIGAD_PARTICIPANT_NOTIFICATION_ENABLED=true
BARAIGAD_PARTICIPANT_NOTIFICATION_EMAIL_ENABLED=true
BARAIGAD_PARTICIPANT_NOTIFICATION_WHATSAPP_ENABLED=true
# Leave blank to notify the participant, or set a team email/mobile to notify your team.
BARAIGAD_PARTICIPANT_NOTIFICATION_EMAIL_TO=
BARAIGAD_PARTICIPANT_NOTIFICATION_WHATSAPP_TO=
# Templates may use: {name}, {email}, {mobile}, {district}, {taluka}, {interest}
BARAIGAD_PARTICIPANT_NOTIFICATION_EMAIL_SUBJECT=Ba Raigad Parivar - Join Us registration received
BARAIGAD_PARTICIPANT_NOTIFICATION_EMAIL_TEMPLATE=Hello {name}, thank you for joining Ba Raigad Parivar.
BARAIGAD_PARTICIPANT_NOTIFICATION_WHATSAPP_TEMPLATE=Hello {name}, thank you for joining Ba Raigad Parivar.
CORS_ALLOWED_ORIGINS=https://preprod.baraigad.com
BARAIGAD_FORM_IMAGE_UPLOAD_DIR=/var/lib/baraigad/uploads/forms
BARAIGAD_MOHIM_IMAGE_UPLOAD_DIR=/var/lib/baraigad/uploads/mohims
BARAIGAD_FORT_MEDIA_UPLOAD_DIR=/var/lib/baraigad/uploads/forts
BARAIGAD_GALLERY_MEDIA_UPLOAD_DIR=/var/lib/baraigad/uploads/gallery
BARAIGAD_FORM_IMAGE_MAX_FILE_SIZE=5MB
BARAIGAD_MOHIM_IMAGE_MAX_FILE_SIZE=20MB
# Gallery videos can use the global multipart maximum.
BARAIGAD_MULTIPART_MAX_FILE_SIZE=100MB
BARAIGAD_MULTIPART_MAX_REQUEST_SIZE=100MB
