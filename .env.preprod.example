# Copy this file to .env on the server. Do not commit the completed .env file.
POSTGRES_DB=baraigad
POSTGRES_USER=baraigad
POSTGRES_PASSWORD=replace-with-a-long-unique-database-password

# Use a random 32+ character secret, not a readable sentence.
JWT_SECRET=replace-with-a-long-random-jwt-secret
PUBLIC_ORIGIN=https://your-domain.example
CORS_ALLOWED_ORIGINS=https://your-domain.example
WEB_PORT=80

# SMTP (use a Google App Password, not the normal Google account password).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional WhatsApp Cloud API credentials.
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=

# Set only for the first successful startup, then remove the password line.
INITIAL_SUPER_ADMIN_EMAIL=
INITIAL_SUPER_ADMIN_PASSWORD=
INITIAL_SUPER_ADMIN_NAME=
