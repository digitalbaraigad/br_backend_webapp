# Copy this file to .env on the server. Do not commit the completed .env file.
# These values also support direct (non-Docker) pre-production deployments.
SPRING_PROFILES_ACTIVE=preprod
SERVER_PORT=8080
DB_URL=jdbc:postgresql://<host>:5432/<database>
DB_USERNAME=<database-user>
DB_PASSWORD=<database-password>
POSTGRES_DB=baraigad
POSTGRES_USER=baraigad
POSTGRES_PASSWORD=replace-with-a-long-unique-database-password

# Use a random 32+ character secret, not a readable sentence.
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_EXPIRATION=86400000
PUBLIC_ORIGIN=https://baraigad.com
CORS_ALLOWED_ORIGINS=https://baraigad.com,https://www.baraigad.com
WEB_PORT=80

# SMTP (use a Google App Password, not the normal Google account password).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional WhatsApp Cloud API credentials.
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=

# Join Us notifications. Leave recipient overrides blank to notify the participant.
BARAIGAD_PARTICIPANT_NOTIFICATION_ENABLED=true
BARAIGAD_PARTICIPANT_NOTIFICATION_EMAIL_ENABLED=true
BARAIGAD_PARTICIPANT_NOTIFICATION_WHATSAPP_ENABLED=true
BARAIGAD_PARTICIPANT_NOTIFICATION_EMAIL_TO=
BARAIGAD_PARTICIPANT_NOTIFICATION_WHATSAPP_TO=
BARAIGAD_PARTICIPANT_NOTIFICATION_EMAIL_SUBJECT=Ba Raigad Parivar - Join Us registration received
BARAIGAD_PARTICIPANT_NOTIFICATION_EMAIL_TEMPLATE=Hello {name}, thank you for joining Ba Raigad Parivar.
BARAIGAD_PARTICIPANT_NOTIFICATION_WHATSAPP_TEMPLATE=Hello {name}, thank you for joining Ba Raigad Parivar.

# Persistent upload folders used by direct deployments. Docker provides these.
BARAIGAD_FORM_IMAGE_UPLOAD_DIR=/var/lib/baraigad/uploads/forms
BARAIGAD_MOHIM_IMAGE_UPLOAD_DIR=/var/lib/baraigad/uploads/mohims
BARAIGAD_FORT_MEDIA_UPLOAD_DIR=/var/lib/baraigad/uploads/forts
BARAIGAD_GALLERY_MEDIA_UPLOAD_DIR=/var/lib/baraigad/uploads/gallery
BARAIGAD_WORK_BANNER_UPLOAD_DIR=/var/lib/baraigad/uploads/work-banners
BARAIGAD_FORM_IMAGE_MAX_FILE_SIZE=5MB
BARAIGAD_MOHIM_IMAGE_MAX_FILE_SIZE=20MB
BARAIGAD_MULTIPART_MAX_FILE_SIZE=100MB
BARAIGAD_MULTIPART_MAX_REQUEST_SIZE=100MB

# Set only for the first successful startup, then remove the password line.
INITIAL_SUPER_ADMIN_EMAIL=
INITIAL_SUPER_ADMIN_PASSWORD=
INITIAL_SUPER_ADMIN_NAME=
